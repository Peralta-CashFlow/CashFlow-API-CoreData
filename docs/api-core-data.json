{
  "openapi": "3.0.1",
  "info": {
    "title": "CashFlow-API-CoreData",
    "description": "This API is responsible for core data management on CashFlow app.",
    "contact": {
      "name": "Vinicius Peralta",
      "email": "vinicius.peralta@hotmail.com"
    },
    "license": {
      "name": "MIT License",
      "url": "http://www.opensource.org/licenses/mit-license.php"
    },
    "version": "0.0.3"
  },
  "servers": [
    {
      "url": "http://localhost:8091",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Category",
      "description": "Category related operations"
    }
  ],
  "paths": {
    "/core/category": {
      "post": {
        "tags": [
          "Category"
        ],
        "summary": "Register a new Category",
        "description": "Should register a new category from the provided request data",
        "operationId": "registerCategory",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used on response messages",
            "example": "en"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token",
            "required": true,
            "example": "JWT.TOKEN.HERE"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryCreationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Category registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorySummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Category already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Category"
        ],
        "summary": "Edit category by ID",
        "description": "Should edit a category for the provided category ID and request data",
        "operationId": "editCategoryById",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used on response messages",
            "example": "en"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token",
            "required": true,
            "example": "JWT.TOKEN.HERE"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryEditionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No category found with the provided ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Duplicate tag name - Another tag with the same name already exists in the category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "200": {
            "description": "Category edited successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/core/category/{categoryId}": {
      "get": {
        "tags": [
          "Category"
        ],
        "summary": "Get category by ID",
        "description": "Should return a category response for the provided category ID",
        "operationId": "getCategoryById",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used on response messages",
            "example": "en"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token",
            "required": true,
            "example": "JWT.TOKEN.HERE"
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "The category ID to retrieve",
            "example": 1
          },
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No category found with the provided ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "200": {
            "description": "Category retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Category"
        ],
        "summary": "Delete category by ID",
        "description": "Should delete a category and it's tags from the provided category ID",
        "operationId": "deleteCategoryById",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used on response messages",
            "example": "en"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token",
            "required": true,
            "example": "JWT.TOKEN.HERE"
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "The category ID to delete",
            "example": 1
          },
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - No category found with the provided ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "200": {
            "description": "Category deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/core/category/list": {
      "get": {
        "tags": [
          "Category"
        ],
        "summary": "List categories",
        "description": "Should return a paged response of categories from the provided request data",
        "operationId": "listCategories",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Language to be used on response messages",
            "example": "en"
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT token",
            "required": true,
            "example": "JWT.TOKEN.HERE"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "The requested page",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The page size",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            },
            "example": 10
          },
          {
            "name": "search",
            "in": "query",
            "description": "The filter text search",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            },
            "example": "filter"
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized - JWT token is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            }
          },
          "200": {
            "description": "List of categories retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategorySummaryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryCreationRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category name",
            "example": "Groceries"
          },
          "color": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category color in HEX format",
            "example": "#FF5733"
          },
          "icon": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category icon",
            "example": ":)"
          }
        },
        "description": "Category creation request"
      },
      "CategorySummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Category ID",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Category name",
            "example": "Groceries"
          },
          "color": {
            "type": "string",
            "description": "Category color in HEX format",
            "example": "#FF5733"
          },
          "icon": {
            "type": "string",
            "description": "Category icon",
            "example": ":)"
          }
        },
        "description": "Category summarized response"
      },
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Exception title",
            "example": "Invalid request data"
          },
          "message": {
            "type": "string",
            "description": "Exception message",
            "example": "The provided request data is invalid."
          },
          "className": {
            "type": "string",
            "description": "Exception class name",
            "example": "UserController.java"
          },
          "methodName": {
            "type": "string",
            "description": "Exception method name",
            "example": "register"
          }
        },
        "description": "CashFlow's Exception base response."
      },
      "CategoryEditionRequest": {
        "required": [
          "id",
          "name",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category name",
            "example": "Groceries"
          },
          "color": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category color in HEX format",
            "example": "#FF5733"
          },
          "icon": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Category icon",
            "example": ":)"
          },
          "tags": {
            "type": "array",
            "description": "List of tags associated with the category",
            "items": {
              "$ref": "#/components/schemas/TagRequest"
            }
          }
        },
        "description": "Category edition request"
      },
      "TagRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Tag ID",
            "format": "int64",
            "example": 1
          },
          "name": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Tag name",
            "example": "Important"
          }
        },
        "description": "Tag request"
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Category ID",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Category name",
            "example": "Groceries"
          },
          "color": {
            "type": "string",
            "description": "Category color in HEX format",
            "example": "#FF5733"
          },
          "icon": {
            "type": "string",
            "description": "Category icon",
            "example": ":)"
          },
          "createdAt": {
            "type": "string",
            "description": "When the category was created",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the category was last updated",
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "description": "Tags associated with the category",
            "items": {
              "$ref": "#/components/schemas/TagResponse"
            }
          }
        },
        "description": "Category complete response"
      },
      "TagResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Tag ID",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Tag name",
            "example": "Important"
          }
        },
        "description": "Tag response"
      }
    }
  }
}